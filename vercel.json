{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.sohamjuneja.in/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "sohamjuneja.in"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}